          <mxGeometry relative="1" x="-0.8258" y="1" as="geometry">
            <mxPoint x="-1" y="1" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="TX4009m4u_vXZrdfmmcY-82" edge="1" parent="TX4009m4u_vXZrdfmmcY-85" style="endArrow=classic;html=1;rounded=0;defaultLabelBackgroundColor=page;strokeWidth=5;" target="TX4009m4u_vXZrdfmmcY-46" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="1040" y="364" as="sourcePoint" />
            <mxPoint x="490" y="540" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="TX4009m4u_vXZrdfmmcY-83" edge="1" parent="TX4009m4u_vXZrdfmmcY-85" style="endArrow=classic;html=1;rounded=0;defaultLabelBackgroundColor=page;strokeWidth=5;" target="TX4009m4u_vXZrdfmmcY-53" value="">
          <mxGeometry height="50" relative="1" width="50" x="-0.5067" as="geometry">
            <Array as="points">
              <mxPoint x="1040" y="776" />
            </Array>
            <mxPoint x="1039.94" y="450" as="sourcePoint" />
            <mxPoint x="1141.94" y="450" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Twqqt8sDEQhHJ3gu8GZg-148" parent="TX4009m4u_vXZrdfmmcY-85" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=light-dark(#FFFFFF,#E6FFCC);strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=light-dark(#FFFFFF,#E6FFCC);shadow=1;size=20;autosizeText=1;fontSize=9;container=0;" value="&lt;span style=&quot;color: rgb(255, 255, 255);&quot;&gt;arma la respuesta a partir del resultado del caso de uso,&amp;nbsp;así el caso de uso no depende de la pantalla. hay un presenter por caso de uso, porque cada respuesta tiene una forma distinta&lt;/span&gt;" vertex="1">
          <mxGeometry height="56" width="214" x="40" y="30" as="geometry" />
        </mxCell>
        <mxCell id="TX4009m4u_vXZrdfmmcY-128" parent="TX4009m4u_vXZrdfmmcY-85" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=light-dark(#FFFFFF,#E6FFCC);strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=light-dark(#FFFFFF,#E6FFCC);shadow=1;size=20;autosizeText=1;fontSize=7;container=0;" value="&lt;span style=&quot;color: rgb(255, 255, 255);&quot;&gt;hace los pasos de solicitar una reserva: verifica el asiento, genera el id, guarda, publica y entrega el resultado&lt;/span&gt;" vertex="1">
          <mxGeometry height="34" width="145" x="550" y="100" as="geometry" />
        </mxCell>
        <mxCell id="TX4009m4u_vXZrdfmmcY-97" edge="1" parent="1" source="TX4009m4u_vXZrdfmmcY-91" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;dashed=1;endArrow=none;endFill=0;" target="Twqqt8sDEQhHJ3gu8GZg-99">
          <mxGeometry relative="1" x="0.0218" as="geometry">
            <Array as="points">
              <mxPoint x="-110" y="820" />
              <mxPoint x="-110" y="820" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="TX4009m4u_vXZrdfmmcY-91" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=light-dark(#000000,#000000);darkOpacity=0.05;fillColor=light-dark(#FFFFFF,#E6FFCC);strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=light-dark(#FFFFFF,#E6FFCC);shadow=1;size=20;autosizeText=1;fontSize=7;container=0;" value="&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Al iniciar la app, conecta cada interfaz con su clase concreta. ejemplo con el caso de uso solicitar reserva:&lt;/b&gt;&lt;br&gt;&lt;br&gt;ISolicitarReservaInputPort → RequestReservationUseCase&lt;br&gt;&lt;br&gt;ISolicitarReservaOutputPort → SolicitarReservaPresenter&lt;br&gt;&lt;br&gt;&lt;b&gt;Contratos compartidos por todos los casos de uso:&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;nbsp;IReservationRequestRepository → ReservationRequestRepository&lt;br&gt;&lt;br&gt;IReservationRequestPublisher → AzureServiceBusReservationRequestPublisher&lt;br&gt;&lt;br&gt;IBookingAvailabilityClient → BookingAvailabilityHttpClient&lt;/p&gt;&lt;p dir=&quot;ltr&quot;&gt;&amp;nbsp; &amp;nbsp;ISeatRepository → SeatRepository&amp;nbsp;&lt;br&gt;&lt;br&gt;los otros tres casos de uso (listar eventos, consultar disponibilidad y consultar estado) se conectan igual: cada uno con su input port, su caso de uso, su output port y su presenter.&lt;/p&gt;" vertex="1">
          <mxGeometry height="199" width="275" x="-350" y="721.5" as="geometry" />
        </mxCell>
        <mxCell id="TX4009m4u_vXZrdfmmcY-95" edge="1" parent="1" source="TX4009m4u_vXZrdfmmcY-93" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;dashed=1;endArrow=none;endFill=0;" target="Twqqt8sDEQhHJ3gu8GZg-99">
          <mxGeometry relative="1" x="0.073" as="geometry">
            <Array as="points">
              <mxPoint x="-60" y="980" />
              <mxPoint x="-60" y="840" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="TX4009m4u_vXZrdfmmcY-93" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=light-dark(#000000,#000000);darkOpacity=0.05;fillColor=light-dark(#FFFFFF,#E6FFCC);strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=light-dark(#FFFFFF,#E6FFCC);shadow=1;size=20;autosizeText=1;fontSize=8;container=0;" value="&lt;p dir=&quot;ltr&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;p dir=&quot;ltr&quot;&gt;además registra (sin interfaz): ReservaController, el AvailabilityDbContext con SQLite, la autenticación JWT con AddKeycloakAuthentication (confiando en Keycloak) y la conexión a Service Bus con su connection string&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="255" x="-341" y="940" as="geometry" />
        </mxCell>
        <mxCell id="TX4009m4u_vXZrdfmmcY-99" edge="1" parent="1" source="TX4009m4u_vXZrdfmmcY-98" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;endArrow=none;endFill=0;dashed=1;" target="Twqqt8sDEQhHJ3gu8GZg-39">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="10" y="61.3" />
              <mxPoint x="10" y="61.3" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="TX4009m4u_vXZrdfmmcY-98" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=light-dark(#FFFFFF,#E6FFCC);strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=light-dark(#FFFFFF,#E6FFCC);shadow=1;size=20;autosizeText=1;fontSize=13;container=0;" value="&lt;span style=&quot;color: rgb(255, 255, 255);&quot;&gt;Decisión: el DbContext usa directamente las entidades del Domain. En este caso la base de datos no necesita datos específicos que al resto del negocio no le importen, así que evitamos los mappers&lt;/span&gt;" vertex="1">
          <mxGeometry height="121.5" width="183" x="-258" y="0.5" as="geometry" />
        </mxCell>
        <mxCell id="TX4009m4u_vXZrdfmmcY-102" edge="1" parent="1" source="TX4009m4u_vXZrdfmmcY-101" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;endArrow=none;endFill=0;dashed=1;" target="Twqqt8sDEQhHJ3gu8GZg-117">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="700" y="-270" />
              <mxPoint x="700" y="-270" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="TX4009m4u_vXZrdfmmcY-101" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=light-dark(#FFFFFF,#E6FFCC);strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=light-dark(#FFFFFF,#E6FFCC);shadow=1;size=20;autosizeText=1;fontSize=7;container=0;" value="&lt;span style=&quot;color: rgb(255, 255, 255);&quot;&gt;decisión: dos controllers. el de la API (azul) habla HTTP; este no sabe nada de la web. si cambia la forma de entrada, solo cambia el otro&amp;nbsp; controller&lt;/span&gt;" vertex="1">
          <mxGeometry height="34" width="183" x="570" y="-328" as="geometry" />
        </mxCell>
        <mxCell id="TX4009m4u_vXZrdfmmcY-125" edge="1" parent="1" source="TX4009m4u_vXZrdfmmcY-124" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;dashed=1;endArrow=none;endFill=0;" target="GG_mx2uGcQPLXj2_ZyCx-63">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="770" y="683" />
              <mxPoint x="770" y="683" />
            </Array>

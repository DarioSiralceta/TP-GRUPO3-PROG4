@model List<Availability.Web.Models.EventoViewModel>

@{
    ViewData["Title"] = "Eventos";
}

<h1>Eventos</h1>

<p>Elegí un evento para consultar sus asientos.</p>

@if (ViewBag.Error != null)
{
    <div class="alert alert-warning" role="alert">
        @ViewBag.Error
    </div>

    <a asp-controller="Eventos"
       asp-action="Index"
       class="btn btn-primary">
        Reintentar
    </a>
}
else if (Model.Count == 0)
{
    <div class="alert alert-info" role="status">
        No hay eventos publicados.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Evento</th>
                    <th>Lugar</th>
                    <th>Fecha y hora local</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var evento in Model)
                {
                    <tr>
                        <td>@evento.Nombre</td>
                        <td>@evento.Lugar</td>
                        <td>
                            @evento.Fecha.ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td>
                            <a asp-controller="Asientos"
                               asp-action="Index"
                               asp-route-eventoId="@evento.Id"
                               class="btn btn-primary btn-sm">
                                Ver asientos
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
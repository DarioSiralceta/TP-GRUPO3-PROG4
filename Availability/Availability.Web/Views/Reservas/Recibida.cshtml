@model Availability.Web.Models.SolicitudReservaViewModel

@{
    ViewData["Title"] = "Solicitud recibida";
}

<h1>Solicitud recibida</h1>

<div class="alert alert-success" role="status">
    Availability recibió tu solicitud para su procesamiento.
    Esto todavía no confirma la reserva.
</div>

<p><strong>Evento:</strong> @Model.NombreEvento</p>
<p><strong>Asiento:</strong> @Model.NumeroAsiento</p>

<p>
    <strong>Identificador de solicitud:</strong>
    @Model.SolicitudId
</p>

<div class="alert alert-info">
    Conservá este identificador.
    La consulta del resultado estará disponible cuando
    terminemos de integrar el seguimiento.
</div>

<a asp-controller="Asientos"
   asp-action="Index"
   asp-route-eventoId="@Model.EventoId"
   class="btn btn-primary">
    Volver a los asientos
</a>
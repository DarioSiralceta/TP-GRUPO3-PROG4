@model Availability.Web.Models.SolicitudReservaViewModel

@{
    ViewData["Title"] = "Solicitar reserva";
}

<h1>Solicitar reserva</h1>

<p><strong>Evento:</strong> @Model.NombreEvento</p>
<p><strong>Asiento:</strong> @Model.NumeroAsiento</p>

@if (ViewBag.Error != null)
{
    <div class="alert alert-warning" role="alert">
        @ViewBag.Error
    </div>
}
else
{
    <div class="alert alert-info">
        Enviaremos tu solicitud para que sea procesada.
        La recepción no garantiza que la reserva quede confirmada.
    </div>

    <form asp-controller="Reservas"
          asp-action="Confirmar"
          method="post">

        <input type="hidden"
               name="eventoId"
               value="@Model.EventoId" />

        <input type="hidden"
               name="seatId"
               value="@Model.SeatId" />

        <button type="submit" class="btn btn-primary">
            Enviar solicitud
        </button>
    </form>
}

<a asp-controller="Asientos"
   asp-action="Index"
   asp-route-eventoId="@Model.EventoId"
   class="btn btn-secondary mt-3">
    Volver a los asientos
</a>
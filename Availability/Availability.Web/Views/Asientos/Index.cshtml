@model List<Availability.Web.Models.AsientoViewModel>

@{
    ViewData["Title"] = "Asientos";
}

<h1>Disponibilidad de asientos</h1>

@if (ViewBag.NombreEvento != null)
{
    <h2>@ViewBag.NombreEvento</h2>
}

<a asp-controller="Eventos" asp-action="Index">
    Volver a eventos
</a>

@if (ViewBag.Error != null)
{
    <div class="alert alert-warning mt-3" role="alert">
        @ViewBag.Error
    </div>

    <a asp-controller="Asientos"
       asp-action="Index"
       asp-route-eventoId="@ViewBag.EventoId"
       class="btn btn-primary">
        Reintentar
    </a>
}
else if (Model.Count == 0)
{
    <div class="alert alert-info mt-3" role="status">
        Este evento no tiene asientos registrados.
    </div>
}
else
{
    <p class="mt-3">
        La disponibilidad puede cambiar mientras realizás la solicitud.
        El asiento se asegura cuando la reserva queda confirmada.
    </p>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Asiento</th>
                    <th>Estado</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var asiento in Model)
                {
                    <tr>
                        <td>@asiento.Numero</td>
                        <td>
                            @if (asiento.Disponible)
                            {
                                <span class="text-success">
                                    Disponible
                                </span>
                            }
                            else
                            {
                                <span class="text-danger">
                                    Ocupado
                                </span>
                            }
                        </td>
                        <td>
                            @if (asiento.Disponible)
                            {
                                <a asp-controller="Reservas"
                                   asp-action="Solicitar"
                                   asp-route-eventoId="@ViewBag.EventoId"
                                   asp-route-seatId="@asiento.SeatId"
                                   class="btn btn-primary btn-sm">
                                    Solicitar reserva
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}